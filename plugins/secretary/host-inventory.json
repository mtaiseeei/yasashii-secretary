{
  "schemaVersion": 3,
  "collaborationMarker": "yasashii-secretary:clarity-collaboration:host:v1",
  "collaborationInventory": "collaboration-inventory.json",
  "pluginRoot": {
    "strategy": "skill-file-realpath-v1",
    "resolver": "scripts/resolve-plugin-root.mjs",
    "forbiddenInputs": [
      "unset environment variable",
      "empty path",
      "unresolved placeholder",
      "relative path",
      "current working directory"
    ]
  },
  "distributionSurfaces": {
    "claudeCode": {
      "marketplace": ".claude-plugin/marketplace.json",
      "manifest": ".claude-plugin/plugin.json",
      "explicitInvocation": "slash-command",
      "updateSurface": "Claude plugin marketplace"
    },
    "codex": {
      "marketplace": "../../.agents/plugins/marketplace.json",
      "manifest": ".codex-plugin/plugin.json",
      "explicitInvocation": "$skill-name",
      "updateSurface": "Plugins Directory or Codex CLI plugin marketplace"
    }
  },
  "releaseInventory": "release-inventory.json",
  "clarityHook": {
    "commonManifest": "hooks/hooks.json",
    "commonRouter": "scripts/clarity-hook.mjs",
    "manualFallback": [
      "status",
      "attention",
      "review",
      "checkpoint",
      "doctor"
    ],
    "hosts": {
      "claudeCode": {
        "desktop": {
          "status": "supported",
          "supported": true,
          "verified": false,
          "degraded": false,
          "reason": "Claude Code DesktopでのYasashii candidate 0.11.0 Clarity Hook実機確認は未実行です。"
        },
        "cli": {
          "status": "supported",
          "supported": true,
          "verified": false,
          "degraded": false,
          "reason": "Claude Code CLIでのYasashii candidate 0.11.0 Clarity Hook実機確認は未実行です。"
        },
        "disabled": {
          "status": "degraded",
          "supported": true,
          "verified": false,
          "degraded": true,
          "canonicalWrite": false,
          "reason": "Hook無効時は手動fallbackを使い、Hook由来canonical writeを行いません。"
        }
      },
      "codex": {
        "app": {
          "status": "supported",
          "supported": true,
          "verified": false,
          "degraded": false,
          "reason": "Codex AppでのYasashii candidate 0.11.0 Clarity Hook実機確認は未実行です。"
        },
        "cli": {
          "status": "supported",
          "supported": true,
          "verified": false,
          "degraded": false,
          "reason": "Codex CLIの主要eventは過去candidateで一部確認済みですが、compact後resume SessionStartを含むYasashii candidate 0.11.0の完全な実機確認は未完了です。"
        },
        "untrusted": {
          "status": "degraded",
          "supported": true,
          "verified": false,
          "degraded": true,
          "canonicalWrite": false,
          "reviewSurface": "/hooks",
          "reason": "trust前はHookを実行せず、手動fallbackを案内します。"
        },
        "disabled": {
          "status": "degraded",
          "supported": true,
          "verified": false,
          "degraded": true,
          "canonicalWrite": false,
          "reason": "Hook無効時は手動fallbackを使い、Hook由来canonical writeを行いません。"
        }
      }
    },
    "promotionRule": "A verified result belongs only to its exact host and surface. supported, verified, degraded, and unverified are never promoted across hosts."
  },
  "collaborationRouting": {
    "router": "scripts/collaboration-router.mjs",
    "execution": "selection-only",
    "sideEffect": {
      "fileWrites": 0,
      "adapterCalls": 0,
      "commandCalls": 0,
      "externalCalls": 0
    },
    "manualFallback": "skills/clarity/SKILL.md",
    "verified": false,
    "reason": "Natural-language fixtureはoffline検証対象です。host実会話のverifiedへ昇格しません。"
  },
