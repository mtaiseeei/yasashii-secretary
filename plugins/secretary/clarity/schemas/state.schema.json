{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic-secretary://clarity/state.schema.json",
  "title": "ClarityState",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "clarityProjectId", "generatedAt", "source", "quadrants", "items"],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "clarityProjectId": { "type": "string", "pattern": "^cp_[a-f0-9]{20}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventCount", "evidenceCount"],
      "properties": {
        "eventCount": { "type": "integer", "minimum": 0 },
        "evidenceCount": { "type": "integer", "minimum": 0 }
      }
    },
    "quadrants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stabilize", "execute", "validate", "decide"],
      "properties": {
        "stabilize": { "$ref": "#/$defs/itemIds" },
        "execute": { "$ref": "#/$defs/itemIds" },
        "validate": { "$ref": "#/$defs/itemIds" },
        "decide": { "$ref": "#/$defs/itemIds" }
      }
    },
    "items": { "type": "array", "items": { "$ref": "item.schema.json" } }
  },
  "$defs": {
    "itemIds": { "type": "array", "items": { "type": "string", "pattern": "^ci_[a-f0-9]{20}$" }, "uniqueItems": true }
  }
}
